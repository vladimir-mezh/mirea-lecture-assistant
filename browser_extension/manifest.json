{
  "manifest_version": 3,
  "name": "МИРЭА: помощник входа",
  "version": "1.3.0",
  "background": {
    "service_worker": "code-worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://sso.mirea.ru/*"
  ],
  "description": "Нажимает «Пропустить» на «Подтверждении через МАКС» и вводит код из почты при входе в МИРЭА. Работает вместе с MIREA Lecture Assistant.",
  "content_scripts": [
    {
      "matches": [
        "https://sso.mirea.ru/*"
      ],
      "js": [
        "skip-max.js",
        "email-code.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "МИРЭА: помощник входа"
  }
}
